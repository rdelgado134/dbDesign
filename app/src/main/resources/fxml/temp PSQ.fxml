


<!-- previous version of project_sql_queries, don't delete until new version confirmed to work. -->

<VBox fx:controller="com.db440.ProjectSQLController"
      xmlns:fx="http://javafx.com/fxml" 
      alignment="CENTER" 
      spacing="15">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- 1. Header -->
    <Label fx:id="sqlQueries" text="SQL Queries">
        <font>
            <Font name="Arial" size="24"/>
        </font>
    </Label>

    <!-- 2. Menu Buttons -->
    <Button fx:id="query_1" text="SQL Query 1"
            prefWidth="160" prefHeight="40"
            onAction="#goToQuery1"/>

    <Button fx:id="query_2" text="SQL Query 2"
            prefWidth="160" prefHeight="40"
            onAction="#goToQuery2"/>

    <Button fx:id="query_3" text="SQL Query 3"
            prefWidth="160" prefHeight="40"
            onAction="#goToQuery3"/>

    <Button fx:id="query_4" text="SQL Query 4"
            prefWidth="160" prefHeight="40"
            onAction="#goToQuery4"/>

    <Button fx:id="query_5" text="SQL Query 5"
            prefWidth="160" prefHeight="40"
            onAction="#goToQuery5"/>

    <Button fx:id="query_6" text="SQL Query 6"
            prefWidth="160" prefHeight="40"
            onAction="#goToQuery6"/>

    <!-- 3. Spacer to separate the actions from back button -->
    <Region prefHeight="20"/>

    <!-- 4. Back Button -->
    <Button text="Back"
            prefWidth="160" prefHeight="40"
            onAction="#back"/>

</VBox>
